pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
    }

    stages {     
        stage('First checkout') {
            steps {
                checkout scm
            }
        }
    
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Maxibanex', url: 'https://github.com/Maxibanex/Practica_Jenkins.git'
            }
        }

        stage('clean workspace') {
            steps {
                cleanWs()

                script {
                    sh 'chmod +x terraformw'
                }
            }
        }

        stage('TF Init&Plan') {
        steps {
          sh './terraformw terraform init'
          sh './terraformw terraform plan'
            }      
        }

        stage('terraform Apply') {
            steps {
                sh './terraformw apply --auto-approve'
            }
        }
    }
}



