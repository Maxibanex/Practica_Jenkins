pipeline {
    agent any

    stages {
        stage('clean workspace') {
            steps {
                cleanWs()
            }
        }
    
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Maxibanex', url: 'https://github.com/Maxibanex/Practica_Jenkins.git'
            }
        }
        stage('TF Init&Plan') {
        steps {
          sh './terraformw terraform init'
          sh './terraformw terraform plan'
            }      
        }

        stage('terraform Apply') {
            steps {
                sh './terraformw apply --auto-approve'
            }
        }
    }
}



