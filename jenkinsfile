pipeline {
    agent {
      node {
        label "main"
      } 
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Maxibanex', url: 'https://github.com/Maxibanex/Practica_Jenkins.git'
            }
        }
        stage('TF Init&Plan') {
            steps {
            sh 'terraform init'
            sh 'terraform plan'
            }      
        }

        stage('Approval') {
            steps {
            script {
                def userInput = input(id: 'confirm', message: 'Apply Terraform?', parameters: [ [$class: 'BooleanParameterDefinition', defaultValue: false, description: 'Apply terraform', name: 'confirm'] ])
            }
            }
        }

        stage('TF Apply') {
            steps {
            sh 'terraform apply -input=false'
            }
        }
    } 
  }
