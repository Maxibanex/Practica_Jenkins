pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'Maxibanex', url: 'https://github.com/Maxibanex/Practica_Jenkins.git'
            }
        }
        stage('Terraform init') {
            steps {
                sh '/usr/bin/terraform init'
            }
        }
        stage('Terraform apply') {
            steps {
                sh '/usr/bin/terraform apply --auto-approve'
            }
        }
        
    }
}
